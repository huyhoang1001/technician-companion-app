# Environment Variables for EGM FixLog App

# Backend API Base URL for pre-signed URL generation
EXPO_PUBLIC_API_BASE_URL=https://your-backend-api.com

# AWS S3 Configuration (for backend reference)
# These should NOT be exposed in the mobile app
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your-egm-fixlog-bucket